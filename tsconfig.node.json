{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "target": "ES2023",
    // "DOM" is for tests/e2e/**'s page.evaluate()/addInitScript() callback
    // bodies — real code, type-checked like any other, that happens to
    // execute in the browser instead of this (Node) process; `window`/
    // `navigator`/`localStorage` need to resolve as the real DOM types,
    // not `any`, for those callbacks to typecheck at all.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],

    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "src/data/schema.ts",
    "src/data/formula-schema.ts",
    "src/data/snapshot-schema.ts",
    "src/data/stat-ids.ts",
    "src/data/snapshot-selectors.ts",
    "src/engine/**/*.ts",
    "src/persistence/__fixtures__/canvas-v0.ts"
  ]
}
